<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    机器上的全局 NuGet.config 里 packageSources 是空的，会导致还原直接失败。
    这里在仓库内声明源，既能构建，也不影响机器上的其他项目。
    国内网络慢的话，把下面的 nuget.org 换成镜像即可。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
