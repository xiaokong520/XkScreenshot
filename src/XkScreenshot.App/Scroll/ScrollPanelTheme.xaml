<!--
  长截图控制面板的控件皮肤。

  这里**不放颜色**：面板要和覆盖层的工具条是同一套观感，颜色统一由 OverlayPalette 给
  （深浅两套跟着设置里的主题走），由 ScrollPanelWindow 在建窗口时注入，见 ApplyPalette。
  这份文件只留结构：模板、圆角、间距。

  颜色为什么用 DynamicResource：调色板是运行期才定下来的（要等设置读出来，用户还可能
  中途换主题），StaticResource 在解析 XAML 那一刻就把画刷定死了，换不回来。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================= 按钮 ================= -->
  <!--
    和工具条上的图标按钮同一套行为：平时全透明，只有悬停才浮出一层浅底。
    不画常驻的底色框，是这套界面的基本调子 —— 一块深色卡片上再摞一排灰框，
    看起来就又变回网页按钮了。
  -->

  <Style x:Key="PanelButton" TargetType="{x:Type Button}">
    <Setter Property="Height" Value="30" />
    <!--
      单行排版后这一排按钮和左边的尺寸、胶囊挤在同一行，横向padding 收窄两像素。
      「完成/编辑/取消」三个词都是一样的长度，收窄后仍然等宽、仍然好点。
    -->
    <Setter Property="Padding" Value="10,0,10,0" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource PanelText}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Bd"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="7"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelControlHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelControlPressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PanelAccentBorder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    「完成」用工具条里「选中的工具」那套配色：半透明强调色底 + 强调色描边 + 偏亮的强调色字。
    早先它是实心亮蓝的填充按钮 —— 那是网页按钮的样子，跟工具条摆在一起像两个程序。
  -->
  <Style x:Key="PanelAccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PanelButton}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PanelAccentText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Bd"
                  Background="{DynamicResource PanelAccentFill}"
                  BorderBrush="{DynamicResource PanelAccentBorder}"
                  BorderThickness="1"
                  CornerRadius="7"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelAccentHover}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PanelAccent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelAccentFill}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= 自动 / 手动 ================= -->
  <!--
    做成两枚并排的胶囊而不是一个开关：这两项是并列的两种做法，不是「开」和「关」。
    开关只能表达「自动模式：开/关」，而关掉自动之后到底是什么，用户得自己猜。
  -->

  <Style x:Key="ModeChip" TargetType="{x:Type RadioButton}">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="9,0,9,0" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource PanelTextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border x:Name="Bd"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="12"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelControlHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelAccentFill}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PanelAccentBorder}" />
              <Setter Property="Foreground" Value="{DynamicResource PanelAccentText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
