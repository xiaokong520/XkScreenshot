<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>XkScreenshot.Privacy</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <!-- 中文分词 + 词性标注，本地名字识别用 -->
    <PackageReference Include="jieba.NET" Version="0.42.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 人脸检测模型只有两百多 KB，直接打进程序集，不走 models/ 那套运行期下载 -->
    <EmbeddedResource Include="Assets\face_detection_yunet_2023mar.onnx" LogicalName="yunet.onnx" />
    <!-- 结巴的词典和 HMM 模型压完三兆出头，同理内嵌：为一个开关让用户去下十兆词库更烦人 -->
    <EmbeddedResource Include="Assets\jieba-resources.zip" LogicalName="jieba-resources.zip" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XkScreenshot.Privacy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XkScreenshot.Core\XkScreenshot.Core.csproj" />
    <ProjectReference Include="..\XkScreenshot.Ocr\XkScreenshot.Ocr.csproj" />
  </ItemGroup>

</Project>
